# Legacy unified demonstration container - runs the local orchestrator
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install from the same authoritative metadata used by local setup and CI.
COPY pyproject.toml README.md LICENSE ./
COPY taxi_duration_predictor/ ./taxi_duration_predictor/
COPY observability/ ./observability/
COPY main.py ./
RUN python -m pip install --no-cache-dir ".[api,mlops]"

# Create non-root user for security
RUN mkdir -p /app/data && \
    adduser --disabled-password --gecos '' appuser && \
    chown -R appuser:appuser /app
USER appuser

# Expose ports for all services
EXPOSE 8000 8506 5000

# Health check for the main orchestrator
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8506/_stcore/health || exit 1

# Run main.py - just like locally!
CMD ["python", "main.py"]
